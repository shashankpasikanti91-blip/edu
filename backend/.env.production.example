# ============================================================
# SRP Education AI — Backend Production Environment
# ============================================================
# Copy this file to .env.production and fill in all values.
# NEVER commit the actual .env.production file to git.
# ============================================================

# ── Application ──────────────────────────────────────────────
NODE_ENV=production
PORT=5000
APP_NAME=SRP Education AI
APP_URL=https://edu.srpailabs.com
FRONTEND_URL=https://edu.srpailabs.com

# ── Database ─────────────────────────────────────────────────
# Injected by docker-compose.prod.yml via ${DB_PASSWORD}
DATABASE_URL=postgresql://edu_user:CHANGE_ME@edu-db:5432/srp_edu

# ── JWT ──────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=CHANGE_ME_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_MIN_32_CHARS
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── Email (SMTP) ─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@srpailabs.com
SMTP_PASS=CHANGE_ME_APP_PASSWORD
EMAIL_FROM=SRP Education AI <noreply@srpailabs.com>

# ── AI (OpenRouter) ──────────────────────────────────────────
OPENROUTER_API_KEY=CHANGE_ME
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_PRIMARY_MODEL=openai/gpt-4.1
AI_FALLBACK_MODEL=openai/gpt-4o

# ── Payments ─────────────────────────────────────────────────
RAZORPAY_KEY_ID=CHANGE_ME
RAZORPAY_KEY_SECRET=CHANGE_ME
STRIPE_SECRET_KEY=CHANGE_ME
STRIPE_WEBHOOK_SECRET=CHANGE_ME

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── File Upload ──────────────────────────────────────────────
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=uploads

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=warn
LOG_DIR=logs
